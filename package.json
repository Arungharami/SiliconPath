{
  "name": "siliconpath",
  "version": "1.5.0",
  "private": true,
  "description": "SiliconPath — Semiconductor Learning & Lab Development: course concepts, digital learning and future labs",
  "type": "module",
  "scripts": {
    "check": "node scripts/catalog.mjs check && node scripts/check.mjs",
    "test": "node scripts/test.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "catalog": "node scripts/catalog.mjs",
    "export:catalog": "node scripts/catalog.mjs export",
    "format": "prettier --write \"*.js\" \"*.css\" \"*.json\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"*.js\" \"*.css\" \"*.json\" \"scripts/*.mjs\"",
    "test:e2e": "node scripts/e2e.mjs",
    "test:rtl": "node scripts/rtl-crosscheck.mjs --require-tools --verify-synth"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "axe-core": "4.10.2",
    "playwright": "1.64.1",
    "prettier": "3.3.3"
  }
}
